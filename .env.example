# Database
DATABASE_URL=mysql://root@localhost:3306/competitor_analysis

# AI Provider (flexible)
# Options: openai / deepseek / anthropic
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=sk-xxxxx
# Base URL (optional, for custom endpoints like DeepSeek)
# AI_BASE_URL=https://api.deepseek.com

# Proxy (optional, for API access)
# HTTP_PROXY=http://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:10808

# Server
PORT=3001
NODE_ENV=development
